<script>
(function(){
  "use strict";
  var $=function(s,c){return (c||document).querySelector(s)};
  var $$=function(s,c){return Array.prototype.slice.call((c||document).querySelectorAll(s))};
  var set=function(id,v){var e=document.getElementById(id);if(e)e.textContent=v};

  function countdown(){
    var target=new Date(window.RLU_ROOM_START||"2026-09-01T20:00:00-04:00").getTime();
    var t=target-Date.now(); if(t<0)t=0;
    var days=Math.floor(t/86400000);
    var hrs=Math.floor((t%86400000)/3600000);
    var short=days>0?(days+' day'+(days===1?'':'s')):(hrs+' hour'+(hrs===1?'':'s'));
    set('cd',short);set('sbCd',short);set('tuCd',short);
  }
  countdown(); setInterval(countdown,60000);

  var io=new IntersectionObserver(function(e){
    e.forEach(function(en){ if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target);} });
  },{threshold:0.12,rootMargin:'0px 0px -8% 0px'});
  $$('.reveal').forEach(function(el){io.observe(el)});

  /* bubbles land one after another, like messages coming in */
  var bio=new IntersectionObserver(function(e){
    e.forEach(function(en){
      if(en.isIntersecting){
        $$('.bub').forEach(function(b,i){ setTimeout(function(){ b.classList.add('in'); }, i*220); });
        bio.disconnect();
      }
    });
  },{threshold:0.25});
  var bw=$('.bubbles'); if(bw)bio.observe(bw);

  $$('.fq').forEach(function(q){
    q.addEventListener('click',function(){
      var item=q.parentElement;
      item.classList.toggle('open');
      q.setAttribute('aria-expanded', item.classList.contains('open') ? 'true' : 'false');
    });
  });

  var stickybar=$('#stickybar');
  var ticking=false;
  function onScroll(){
    if(stickybar)stickybar.classList.toggle('show',window.pageYOffset>700);
    ticking=false;
  }
  window.addEventListener('scroll',function(){ if(!ticking){requestAnimationFrame(onScroll);ticking=true;} },{passive:true});
  onScroll();

  /* ---------- SEAT INTENT ---------- */
  window.RLU_INTENT='free';
  window.rluIntent=function(v){
    window.RLU_INTENT=v;
    var btn=$('#regSubmit');
    var note=$('#regIntentNote');
    if(v==='vip'){
      if(btn)btn.textContent='Yes! Save My Seat →';
      if(note)note.innerHTML='<b>The room stays open.</b> Register here and you will go straight to your $9 upgrade.';
    }else{
      if(btn)btn.textContent='Yes! Save My Seat →';
      if(note)note.innerHTML='Your Zoom link comes by email.<br>Want the room to stay open? Register here first, then <b>upgrade on your ticket.</b>';
    }
  };

  /* ---------- REGISTER > Klaviyo > thank-you page ----------
     UNCHANGED from the August challenge, which converted at 28.8%.
     Call 1: plain list subscribe (profile info, no consent block)
     Call 2: separate minimal SMS consent call (email + phone + sms consent ONLY)
     Call 3: legacy kmail-lists subscribe, the safety net that has caught every registrant */
  window.KLAVIYO_COMPANY_ID = "Wds554";

  window.rluRegister=function(){
    var name=$('#regName'), email=$('#regEmail'), msg=$('#regMsg');
    if(!email||!msg)return;
    var e=(email.value||'').trim();
    var n=(name&&name.value||'').trim();
    var phoneEl=$('#regPhone');
    var ph=(phoneEl&&phoneEl.value||'').trim();
    if(!e||e.indexOf('@')<1||e.indexOf('.')<0){ msg.style.color='#ff6b8a'; msg.textContent='Enter a valid email so we can send your Zoom link.'; return; }
    var digits=ph.replace(/[^0-9]/g,'');
    if(digits.length<10){ msg.style.color='#ff6b8a'; msg.textContent='Add your phone so we can text your reminder.'; return; }
    msg.style.color='#A39BA0'; msg.textContent='Saving your seat...';

    var e164='';
    if(digits.length===10){ e164='+1'+digits; }
    else if(digits.length===11 && digits.charAt(0)==='1'){ e164='+'+digits; }
    else { e164=(ph.charAt(0)==='+' ? ph : ('+'+digits)); }
    var listId=(window.KLAVIYO_LIST_ID||'VyZKwd');
    var source=(window.RLU_SOURCE||'Retention Room Sept 2026');
    var KH={'Content-Type':'application/json','revision':'2024-10-15'};
    var KURL='https://a.klaviyo.com/client/subscriptions/?company_id='+window.KLAVIYO_COMPANY_ID;

    /* ---- Call 1: plain list subscribe ---- */
    var profileAttrs={
      email:e,
      phone_number:e164,
      properties:{
        rlu_seat_intent:window.RLU_INTENT,
        rlu_source:source
      }
    };
    if(n) profileAttrs.first_name=n;
    var listPayload={
      data:{
        type:'subscription',
        attributes:{
          custom_source:source,
          profile:{data:{type:'profile',attributes:profileAttrs}}
        },
        relationships:{list:{data:{type:'list',id:listId}}}
      }
    };

    /* ---- Call 2: separate minimal SMS consent ---- */
    var smsPayload={
      data:{
        type:'subscription',
        attributes:{
          custom_source:source,
          profile:{data:{type:'profile',attributes:{
            email:e,
            phone_number:e164,
            subscriptions:{ sms:{ marketing:{ consent:'SUBSCRIBED' }, transactional:{ consent:'SUBSCRIBED' } } }
          }}}
        },
        relationships:{list:{data:{type:'list',id:listId}}}
      }
    };

    /* ---- Call 3: legacy kmail-lists subscribe (safety net) ---- */
    var legacy=new URLSearchParams();
    legacy.append('g',listId);
    legacy.append('email',e);
    if(n)legacy.append('$first_name',n);
    legacy.append('$phone_number',e164);
    legacy.append('sms_consent','true');
    legacy.append('$source',source);
    legacy.append('rlu_seat_intent',window.RLU_INTENT);

    var base=(window.RLU_THANKYOU||'/pages/seatconfirmed');
    var qs=[];
    if(window.RLU_INTENT==='vip') qs.push('vip=1');
    if(n) qs.push('name='+encodeURIComponent(n));
    var url=base+(qs.length?('?'+qs.join('&')):'');
    var fired=false;
    try{
      if(typeof fbq==='function'){
        fbq('track','Lead',{content_name:source, content_category:window.RLU_INTENT});
      }
    }catch(err){}
    var go=function(){ if(fired)return; fired=true; window.location.href=url; };

    var p1=fetch(KURL,{method:'POST',headers:KH,body:JSON.stringify(listPayload)}).catch(function(){});
    var p2=fetch(KURL,{method:'POST',headers:KH,body:JSON.stringify(smsPayload)}).catch(function(){});
    var p3=fetch('https://manage.kmail-lists.com/ajax/subscriptions/subscribe',{
      method:'POST',
      headers:{'Content-Type':'application/x-www-form-urlencoded','Cache-Control':'no-cache'},
      body:legacy.toString()
    }).catch(function(){});
    Promise.all([p1,p2,p3]).then(function(){ go(); });
    setTimeout(go,3000); /* fail-safe: never trap her on this page */
  };
})();
</script>
