<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400&display=swap" rel="stylesheet">
<style>
  .shopify-section-group-header-group,.shopify-section-header,#shopify-section-header,
  header.site-header,.site-header,.header-wrapper,.announcement-bar,#shopify-section-announcement-bar,
  .shopify-section-group-footer-group,.shopify-section-footer,#shopify-section-footer,
  footer.site-footer,.site-footer{display:none!important}
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  :root{
    --black:#0A0A0A;--white:#FFF;--ink:#F2EEF0;--soft:#A39BA0;--faint:#6a626a;
    --pink:#F600A2;--pink-soft:#ff5cc5;--green:#4EBB19;--green-soft:#7ee84d;
    --gold:#D4AF37;--gold-soft:#E8C57A;
    --line:rgba(255,255,255,0.1);--linewarm:rgba(212,175,55,0.25);
  }
  html{background:#0A0A0A!important;scroll-behavior:smooth}
  body{background:#0A0A0A!important;color:var(--ink);font-family:'Poppins',sans-serif;font-weight:300;overflow-x:hidden;-webkit-font-smoothing:antialiased}
  img{max-width:100%;display:block}
  a{text-decoration:none;color:inherit}
  a:focus-visible,button:focus-visible,input:focus-visible{outline:2px solid var(--gold-soft);outline-offset:3px}
  .reveal{opacity:0;transform:translateY(30px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
  .reveal.in{opacity:1;transform:none}
  .reveal.d1{transition-delay:.1s}.reveal.d2{transition-delay:.2s}.reveal.d3{transition-delay:.3s}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(78,187,25,0.55)}70%{box-shadow:0 0 0 9px rgba(78,187,25,0)}100%{box-shadow:0 0 0 0 rgba(78,187,25,0)}}
  @media(prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    .pulse-dot{animation:none}
    .reveal,.bub{opacity:1!important;transform:none!important;transition:none!important}
  }

  /* ===== TOP BAR ===== */
  .topbar{background:linear-gradient(90deg,#1a0012,#0a0a0a,#0a1206);text-align:center;padding:11px 16px;font-size:10.5px;font-weight:500;letter-spacing:0.15em;text-transform:uppercase;color:var(--ink);line-height:1.6;border-bottom:1px solid var(--line)}
  .topbar b{color:var(--green-soft)}
  .pulse-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green-soft);animation:pulse 1.8s infinite;margin-right:8px;vertical-align:middle}

  /* ===== NAV ===== */
  nav{background:var(--black);padding:18px 6vw;display:flex;align-items:center;justify-content:center;border-bottom:1px solid rgba(255,255,255,0.06)}
  nav img{height:56px}
  @media(max-width:560px){nav img{height:46px}}

  /* ===== HERO ===== */
  .hero{background:var(--black);padding:9vh 6vw 8vh;text-align:center;position:relative;overflow:hidden}
  .hero::before{content:'';position:absolute;top:-18%;left:0;right:0;margin-inline:auto;width:780px;height:520px;background:radial-gradient(ellipse,rgba(246,0,162,0.16),transparent 62%);pointer-events:none}
  .hero-c{position:relative;z-index:2;max-width:820px;margin:0 auto}
  .hero-ey{display:block;font-size:10px;font-weight:600;letter-spacing:0.38em;text-transform:uppercase;color:var(--gold-soft);margin-bottom:22px}
  .hero h1{font-size:clamp(40px,6.4vw,72px);font-weight:200;line-height:1.04;letter-spacing:-0.03em;color:#fff;margin-bottom:18px}
  .hero h1 em{font-style:italic;font-weight:600;color:var(--pink-soft)}
  .hero .hook{font-size:clamp(19px,2.8vw,28px);font-weight:200;font-style:italic;color:var(--pink-soft);line-height:1.35;margin-bottom:24px}
  .hero-mech{font-size:clamp(15px,2vw,18px);font-weight:500;color:#fff;line-height:1.5;max-width:560px;margin:0 auto 22px;letter-spacing:-.01em}
  .hero .sub{font-size:clamp(15px,2.1vw,19px);color:var(--soft);line-height:1.7;font-weight:300;max-width:620px;margin:0 auto 32px}
  .hero-cred{display:block;margin-top:16px;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-soft);font-weight:600;line-height:2}
  .tkt-more{margin-top:16px;padding-top:14px;border-top:1px solid rgba(212,175,55,.22);font-size:11.5px;line-height:1.9;color:var(--gold-soft);letter-spacing:.02em}
  .tkt-nudge{margin-top:18px;padding-top:16px;border-top:1px solid rgba(255,255,255,.09);font-size:12.5px;line-height:1.75;color:var(--soft);font-weight:300}
  .tkt-nudge b{color:#fff;font-weight:500}
  .hero .sub b{color:var(--gold-soft);font-weight:600}
  .hero-vis{max-width:600px;margin:0 auto 40px;border-radius:12px;overflow:hidden;box-shadow:0 20px 50px rgba(0,0,0,0.5)}
  .hero-when{font-size:clamp(15px,2.2vw,20px);font-weight:500;color:var(--ink);margin-bottom:30px}
  .btn-gold{display:inline-block;width:100%;max-width:520px;padding:20px 40px;border-radius:6px;font-size:clamp(15px,2vw,19px);font-weight:700;color:#fff;background:var(--pink);border:none;cursor:pointer;font-family:'Poppins',sans-serif;transition:transform .18s,box-shadow .25s;box-shadow:0 10px 30px rgba(246,0,162,0.4)}
  .btn-gold:hover{transform:translateY(-2px);box-shadow:0 16px 42px rgba(246,0,162,0.6)}
  .btn-early{margin-top:6px}
  .btn-sub{display:block;margin-top:14px;font-size:14px;color:var(--faint);font-weight:300}

  /* ===== SECTIONS ===== */
  .dark{background:var(--black);color:var(--ink);padding:12vh 6vw}
  .wrap{max-width:1080px;margin:0 auto}
  .center{text-align:center}
  .ey{display:block;font-size:10px;font-weight:500;letter-spacing:0.4em;text-transform:uppercase;color:var(--pink-soft);margin-bottom:22px}
  h2.big{font-size:clamp(30px,4.8vw,56px);font-weight:200;line-height:1.12;letter-spacing:-0.02em;color:#fff}
  h2.big b{font-weight:600}
  h2.big em{font-style:italic;color:var(--pink-soft)}
  .lead{margin-top:22px;font-size:15px;color:var(--soft);line-height:1.95;max-width:580px;font-weight:300}
  .center .lead{margin-left:auto;margin-right:auto}

  /* ===== PAIN ===== */
  .pain-open{max-width:640px;margin:0 auto;text-align:left}
  .pain-open p{font-size:clamp(18px,2.5vw,24px);font-weight:300;color:#fff;line-height:1.6;margin-bottom:14px}
  .pain-open p.sm{font-size:15.5px;color:var(--soft);line-height:1.9;font-weight:300}
  .pain-open .nothing{color:var(--pink-soft);font-weight:500;margin-top:30px;font-size:clamp(18px,2.5vw,23px);text-align:left}
  .said{max-width:760px;margin:9vh auto 0}
  .said-h{text-align:center;font-size:clamp(19px,2.7vw,26px);font-weight:300;color:#fff;margin-bottom:12px;line-height:1.5}
  .said-h b{color:var(--pink-soft);font-weight:600}
  .said-sub{text-align:center;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:var(--faint);margin-bottom:44px}
  .bubbles{display:flex;flex-direction:column;gap:16px}
  .bub{position:relative;max-width:82%;padding:18px 22px;border-radius:20px 20px 20px 6px;background:linear-gradient(160deg,rgba(255,255,255,0.08),rgba(255,255,255,0.035));border:1px solid rgba(255,255,255,0.1);font-size:16px;font-weight:300;line-height:1.65;color:var(--ink);align-self:flex-start;opacity:0;transform:translateY(16px) scale(.98);transition:opacity .55s cubic-bezier(.2,.7,.2,1),transform .55s cubic-bezier(.2,.7,.2,1)}
  .bub.in{opacity:1;transform:none}
  .bub:nth-child(even){align-self:flex-end;border-radius:20px 20px 6px 20px;background:linear-gradient(160deg,rgba(246,0,162,0.13),rgba(246,0,162,0.05));border-color:rgba(246,0,162,0.28)}
  .bub b{color:#fff;font-weight:600}
  .bub.hard{border-color:rgba(246,0,162,0.5);background:linear-gradient(160deg,rgba(246,0,162,0.18),rgba(246,0,162,0.06));max-width:92%}
  .bub.hard b{color:var(--pink-soft)}
  .said-land{margin-top:52px;text-align:center;font-size:clamp(19px,2.8vw,27px);font-weight:200;font-style:italic;color:#fff;line-height:1.6}
  .said-land b{font-style:normal;font-weight:500;color:var(--pink-soft)}
  .cost{max-width:640px;margin:10vh auto 0;text-align:left}
  .cost p{font-size:15.5px;color:var(--soft);line-height:1.95;margin-bottom:18px;font-weight:300}
  .cost p b{color:#fff;font-weight:500}
  .cost-close{margin-top:36px;font-size:clamp(18px,2.6vw,25px);font-weight:200;font-style:italic;color:#fff;line-height:1.55;text-align:left}
  .cost-close b{font-style:normal;font-weight:500;color:var(--pink-soft)}
  @media(max-width:600px){
    .said{margin-top:7vh}
    .said-h{font-size:19px;margin-bottom:10px;line-height:1.45}
    .said-sub{font-size:10px;margin-bottom:30px}
    .bub{max-width:90%;font-size:15.5px;padding:15px 18px;line-height:1.6}
    .bub.hard{max-width:97%}
    .said-land{margin-top:38px;font-size:20px;line-height:1.5}
    .pain-open p{font-size:19px;line-height:1.5}
    .pain-open p.sm{font-size:15px;line-height:1.75}
    .cost{margin-top:7vh}
    .cost p{font-size:15px;line-height:1.75}
    .cost-close{font-size:19px;line-height:1.55;margin-top:26px}
  }

  /* ===== SEATS AS TICKETS ===== */
  .seats{border-top:1px solid rgba(255,255,255,0.08)}
  .seat-grid{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin-top:7vh;text-align:left}
  @media(max-width:900px){.seat-grid{grid-template-columns:1fr}}

  .tkt{position:relative;display:grid;grid-template-columns:62px 1fr;border:1px solid var(--line);border-radius:16px;
       background:linear-gradient(150deg,#141014,#0b0b0c 55%);overflow:hidden;
       transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s,border-color .35s}
  .tkt:hover{transform:translateY(-6px)}
  .tkt::before,.tkt::after{content:'';position:absolute;left:62px;width:20px;height:20px;border-radius:50%;
       background:var(--black);transform:translateX(-50%);z-index:4}
  .tkt::before{top:-10px}
  .tkt::after{bottom:-10px}
  .tkt-stub{border-right:1px dashed rgba(255,255,255,0.22);display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.03)}
  .tkt-stub span{writing-mode:vertical-rl;transform:rotate(180deg);font-size:9.5px;font-weight:700;letter-spacing:0.4em;
       text-transform:uppercase;color:var(--soft)}
  .tkt-body{padding:32px 30px 30px}

  .tkt.gen:hover{border-color:rgba(255,255,255,0.32)}
  .tkt.vip{border-color:rgba(212,175,55,0.55);box-shadow:0 0 60px rgba(212,175,55,0.08)}
  .tkt.vip:hover{border-color:var(--gold-soft);box-shadow:0 30px 70px rgba(212,175,55,0.18)}
  .tkt.vip .tkt-stub{border-right-color:rgba(212,175,55,0.4);background:rgba(212,175,55,0.06)}
  .tkt.vip .tkt-stub span{color:var(--gold-soft)}
  .tkt.vip .tkt-body{background:radial-gradient(ellipse at top right,rgba(212,175,55,0.11),transparent 70%)}

  .tkt-badge{position:absolute;top:22px;right:22px;z-index:5;font-size:9px;font-weight:700;letter-spacing:0.15em;
       text-transform:uppercase;color:#1a1208;background:var(--gold);padding:6px 13px;border-radius:30px}
  .tkt-ven{font-size:9px;letter-spacing:0.32em;text-transform:uppercase;color:var(--faint);font-weight:600;margin-bottom:14px}
  .tkt.vip .tkt-ven{color:var(--gold-soft)}
  .tkt-name{font-size:27px;font-weight:200;color:#fff;line-height:1.15;letter-spacing:-0.01em}
  .tkt-name b{font-weight:600;display:block}
  .tkt-price{margin-top:16px;font-size:42px;font-weight:200;letter-spacing:-0.02em;color:var(--soft);line-height:1}
  .tkt.vip .tkt-price{color:var(--gold-soft)}
  .tkt-per{margin-top:7px;font-size:11.5px;color:var(--faint);font-weight:300;min-height:17px}
  .tkt.vip .tkt-per{color:var(--gold-soft)}
  .tkt-perf{height:1px;margin:24px 0;background:repeating-linear-gradient(90deg,rgba(255,255,255,0.22) 0 5px,transparent 5px 10px)}
  .tkt.vip .tkt-perf{background:repeating-linear-gradient(90deg,rgba(212,175,55,0.4) 0 5px,transparent 5px 10px)}
  .tkt-inc{font-size:8.5px;letter-spacing:0.24em;text-transform:uppercase;color:var(--faint);font-weight:600;margin-bottom:14px}
  .sl2{font-size:13px;line-height:1.6;color:var(--soft);padding:7px 0;font-weight:300;text-align:left}
  .sl2::before{content:'\2713 ';color:var(--green);font-weight:700;margin-right:4px}
  .tkt.vip .sl2::before{color:var(--gold-soft)}
  .sl2 b{color:#fff;font-weight:500}
  .sl2.x{color:#4a444a}
  .sl2.x::before{content:'\2013';color:#4a444a}

  .tkt-hud{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:22px;padding-top:18px;border-top:1px solid rgba(255,255,255,0.09)}
  .tkt-hud div span{display:block;font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:var(--faint);margin-bottom:5px}
  .tkt-hud div b{font-size:12px;font-weight:600;color:#fff}
  .tkt.vip .tkt-hud div b{color:var(--gold-soft)}

  .tkt-foot{margin-top:24px}
  .seat-btn{display:block;text-align:center;width:100%;padding:17px 20px;border-radius:6px;font-size:14px;font-weight:600;
       cursor:pointer;font-family:'Poppins',sans-serif;transition:all .25s;border:1px solid var(--line);background:none;color:var(--soft)}
  .tkt.gen .seat-btn:hover{border-color:#fff;color:#fff;background:rgba(255,255,255,0.06)}
  .tkt.vip .seat-btn{background:var(--gold);color:#1a1208;border-color:var(--gold);font-weight:700;box-shadow:0 8px 24px rgba(212,175,55,0.3)}
  .tkt.vip .seat-btn:hover{background:var(--gold-soft);transform:translateY(-2px)}
  .seat-note{margin-top:13px;text-align:center;font-size:11px;color:var(--faint);line-height:1.7}
  .tkt-bars{display:flex;gap:2px;align-items:flex-end;height:20px;opacity:0.4;margin-top:22px}
  .tkt-bars i{display:block;width:2px;height:100%;background:var(--soft)}
  .tkt-bars i:nth-child(3n){height:55%}.tkt-bars i:nth-child(4n){height:80%}.tkt-bars i:nth-child(5n){height:40%}.tkt-bars i:nth-child(7n){width:3px}
  .tkt.vip .tkt-bars i{background:var(--gold-soft)}

  @media(max-width:560px){
    .tkt{grid-template-columns:46px 1fr}
    .tkt::before,.tkt::after{left:46px}
    .tkt-body{padding:26px 20px 24px}
    .tkt-hud{grid-template-columns:1fr;gap:12px}
  }

  .foundingnote{max-width:560px;margin:22px auto 0;text-align:center;font-size:13.5px;color:var(--soft);line-height:1.8;font-weight:300}
  .foundingnote b{color:var(--gold-soft);font-weight:600}
  .seat-line{max-width:620px;margin:6vh auto 0;text-align:center;font-size:clamp(17px,2.4vw,23px);font-weight:200;font-style:italic;color:#fff;line-height:1.7}
  .seat-line b{font-style:normal;font-weight:500;color:var(--gold-soft)}
  .urgpill{display:inline-flex;align-items:center;justify-content:center;gap:10px;margin:32px auto 0;padding:14px 26px;
       border:1px solid var(--linewarm);border-radius:40px;font-size:13px;color:var(--ink);font-weight:300;
       background:rgba(212,175,55,0.05);flex-wrap:wrap}
  .urgpill b{color:var(--gold-soft);font-weight:600}

  @media(max-width:560px){
    .tkt-name{font-size:23px}
    .tkt-price{font-size:36px}
    .sl2{font-size:12.5px;padding:6px 0}
    .tkt-hud{margin-top:16px !important;padding-top:14px !important}
    .tkt-bars{margin-top:14px !important;height:16px !important}
    .tkt-foot{margin-top:16px !important}
    .tkt-body{padding:22px 18px 20px}
    .foundingnote{font-size:12.5px}
  }

  /* ===== REGISTER ===== */
  .register{background:var(--black);padding:12vh 6vw;text-align:center;color:var(--ink);border-top:1px solid var(--line);position:relative;overflow:hidden}
  .register::before{content:"";position:absolute;top:0;left:0;right:0;margin-inline:auto;width:760px;height:460px;background:radial-gradient(ellipse,rgba(246,0,162,0.11),transparent 62%);pointer-events:none}
  .register > *{position:relative;z-index:2}
  .reg-ey{display:block;font-size:10px;font-weight:600;letter-spacing:0.4em;text-transform:uppercase;color:var(--pink-soft);margin-bottom:20px}
  .register h2{font-size:clamp(28px,4.4vw,46px);font-weight:700;color:#fff;line-height:1.15;margin-bottom:14px}
  .register h2 em{font-style:italic;color:var(--pink-soft)}
  .reg-when{font-size:clamp(15px,2vw,19px);font-weight:500;color:var(--ink);margin-bottom:42px}
  .regbox{max-width:540px;margin:0 auto}
  .rb-form{display:flex;flex-direction:column;gap:14px}
  .rb-form input{width:100%;background:rgba(255,255,255,0.05);border:1px solid var(--line);border-radius:6px;padding:18px 22px;color:#fff;font-family:'Poppins',sans-serif;font-size:16px;font-weight:300}
  .rb-form input::placeholder{color:var(--faint)}
  .rb-form input:focus{outline:none;border-color:var(--pink)}
  .rb-msg{margin-top:16px;font-size:14px;min-height:20px;line-height:1.6;color:var(--soft)}
  .rb-tcpa{margin-top:14px;font-size:10.5px;line-height:1.6;color:#6a626a;font-weight:300;max-width:480px;margin-left:auto;margin-right:auto}
  .rb-after{margin-top:20px;font-size:13.5px;color:var(--faint);line-height:1.7}
  .rb-after b{color:var(--pink-soft);font-weight:600}

  /* ===== TRUST STRIP ===== */
  .tstrip{background:#0d0d0d;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:32px 6vw}
  .tstrip-nums{display:flex;justify-content:center;gap:0;flex-wrap:wrap;max-width:820px;margin:0 auto}
  .tstrip-nums .tn{flex:1;min-width:120px;text-align:center;padding:6px 18px;border-right:1px solid var(--line)}
  .tstrip-nums .tn:last-child{border-right:none}
  .tstrip-nums .tn b{display:block;font-size:clamp(24px,3.4vw,34px);font-weight:200;color:var(--gold-soft);letter-spacing:-0.01em;line-height:1}
  .tstrip-nums .tn span{display:block;margin-top:8px;font-size:8.5px;letter-spacing:0.2em;text-transform:uppercase;color:var(--faint);font-weight:600}
  .tstrip-shots{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:26px;flex-wrap:wrap}
  .tstrip-shots img{width:60px;height:60px;object-fit:cover;object-position:center 25%;border-radius:50%;border:2px solid var(--gold)}
  .tstrip-more{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--soft);font-weight:500;margin-left:6px}
  @media(max-width:560px){
    .tstrip-nums .tn{min-width:88px;padding:6px 8px}
    .tstrip-shots img{width:54px;height:54px}
    .tstrip-more{width:100%;text-align:center;margin:8px 0 0}
  }
  .tstrip-logos{display:flex;align-items:center;justify-content:center;gap:26px;flex-wrap:wrap;margin-top:26px;padding-top:24px;border-top:1px solid var(--line)}
  .tstrip-logos-l{font-size:8.5px;letter-spacing:0.24em;text-transform:uppercase;color:var(--faint);font-weight:600}
  .tstrip-logos img{height:30px;width:auto;opacity:0.55;filter:grayscale(100%) brightness(1.9)}
