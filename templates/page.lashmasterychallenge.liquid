<script>
(function(){
  var strip=document.getElementById('tstripNums');
  if(!strip)return;
  function fmt(n,comma){ return comma ? n.toLocaleString('en-US') : String(n); }
  function run(){
    var els=strip.querySelectorAll('b[data-count]');
    els.forEach(function(el){
      var target=parseInt(el.getAttribute('data-count'),10);
      var suffix=el.getAttribute('data-suffix')||'';
      var comma=el.getAttribute('data-comma')==='1';
      var dur=1400, start=null;
      function step(ts){
        if(!start)start=ts;
        var p=Math.min((ts-start)/dur,1);
        var eased=1-Math.pow(1-p,3);
        var val=Math.round(target*eased);
        el.textContent=fmt(val,comma)+ (p===1?suffix:'');
        if(p<1)requestAnimationFrame(step); else el.textContent=fmt(target,comma)+suffix;
      }
      requestAnimationFrame(step);
    });
  }
  var done=false;
  function fire(){ if(done)return; done=true; run(); }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(e){
      e.forEach(function(en){ if(en.isIntersecting){ fire(); io.disconnect(); } });
    },{threshold:0, rootMargin:'0px 0px -15% 0px'});
    io.observe(strip);
    setTimeout(function(){
      var r=strip.getBoundingClientRect();
      if(r.top < (window.innerHeight||document.documentElement.clientHeight)) fire();
    }, 600);
  } else { run(); }
})();
</script>

