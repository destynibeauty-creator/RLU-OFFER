<script>
  /* ════ APPLICATION ════
     The form is embedded in the #apply section at the bottom of this page,
     loaded from the theme asset assets/lashceo-application.html.
     Buttons scroll to it. To send women to a separate page instead,
     change the hrefs and APPLY_URL to that page's path. */
  window.APPLY_URL = "#apply";

  (function(){
    ['navApply','heroApply','guarApply','finalApply'].forEach(function(id){
      var el=document.getElementById(id);
      if(el && window.APPLY_URL){ el.href=window.APPLY_URL; }
    });
  })();

  /* ===== Auto-size the embedded application iframe (no inner scrollbar) ===== */
  (function(){
    var f=document.getElementById('rlu-apply-frame');
    if(!f) return;
    var heard=false;
    window.addEventListener('message',function(e){
      if(!e.data) return;
      if(e.data.rluApplyHeight){ heard=true; f.style.height=(e.data.rluApplyHeight+24)+'px'; }
      if(e.data.rluApplyScrollTop){
        f.scrollIntoView({behavior:'smooth',block:'start'});
      }
      /* ── Fire Meta Lead event when a real application is submitted ── */
      if(e.data.rluEvent === 'submit'){
        if(window.fbq){ fbq('track', 'Lead'); }
      }
      if(e.data.rluRedirect){ window.location.href=e.data.rluRedirect; }
    });
    /* If the form never reports its height, something is wrong with the asset.
       Show a way out instead of leaving her staring at an empty box. */
    setTimeout(function(){
      if(!heard){
        var fb=document.getElementById('applyFallback');
        if(fb) fb.hidden=false;
      }
    },6000);
  })();

  /* ===== Reveal on scroll ===== */
  (function(){
    var page=document.querySelector('.rlu-page');
    var els=document.querySelectorAll('.reveal');
    if(!('IntersectionObserver' in window) || !page){ return; }
    page.classList.add('reveal-on');
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });
    },{threshold:0.12, rootMargin:'0px 0px -8% 0px'});
    els.forEach(function(e){io.observe(e)});
  })();

  /* ===== Count-up numbers ===== */
  (function(){
    var nums=document.querySelectorAll('[data-count]');
    function run(el){
      var target=parseInt(el.getAttribute('data-count'),10);
      var suffix=el.getAttribute('data-suffix')||'';
      var dur=1400, start=null;
      function step(ts){
        if(!start) start=ts;
        var p=Math.min((ts-start)/dur,1);
        var eased=1-Math.pow(1-p,3);
        var val=Math.floor(eased*target);
        el.textContent=val.toLocaleString('en-US')+(p===1?suffix:'');
        if(p<1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    if(!('IntersectionObserver' in window)){ nums.forEach(run); return; }
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if(en.isIntersecting){ run(en.target); io.unobserve(en.target); } });
    },{threshold:0.6});
    nums.forEach(function(e){io.observe(e)});
  })();

  /* Smart header: hide on scroll down, reveal on scroll up */
  (function(){
    var nav=document.querySelector('.rlu-page nav')||document.querySelector('nav');
    if(!nav) return;
    var last=window.pageYOffset||0;
    window.addEventListener('scroll',function(){
      var y=window.pageYOffset||0;
      if(y>last+8 && y>140){ nav.classList.add('nav-up'); }
      else if(y<last-8){ nav.classList.remove('nav-up'); }
      last=y;
    },{passive:true});
  })();
</script>

