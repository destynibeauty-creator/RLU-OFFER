<!-- 1. HERO -->
<section class="hero">
  <div class="wrap hero-c">
    <span class="ey">Lash Mastery CEO Certification&trade; &middot; Now Enrolling</span>
    <h1>Wake up and <b>choose your own day.</b></h1>
