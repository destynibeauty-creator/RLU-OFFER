<section>
  <div class="wrap">
    <div class="sh reveal">
      <span class="ey">Is This You?</span>
      <h2>You already know <em>which one you are.</em></h2>
    </div>
    <div class="you-grid">
      <div class="you g glass reveal">
        <div class="yn">If you&rsquo;re</div>
