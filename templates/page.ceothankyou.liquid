<script>
(function(){
  "use strict";
  var $=function(s){return document.querySelector(s)};
  var q=new URLSearchParams(window.location.search);

  /* ---- name on the ticket ---- */
  var raw=(q.get('name')||'').trim();
  if(raw){
    var clean=raw.replace(/[^A-Za-z'’\- ]/g,'').slice(0,26);
    if(clean){ $('#tHolder').textContent = clean.charAt(0).toUpperCase()+clean.slice(1); }
  }

  /* ---- tier ---- */
  var isVip = q.get('vip')==='1';
  var vipUrl = (window.RLU_VIP_URL && window.RLU_VIP_URL.indexOf('URL_HERE')<0) ? window.RLU_VIP_URL : '#';
  if(isVip){
    $('#tTier').textContent='Campus';
    var td=$('#tDoors'); if(td){ td.textContent='8 to 9:30 PM ET'; }
    $('#tkt').classList.add('vip');
    var vn=$('#vipnow'); if(vn){ vn.classList.add('show'); }
    var vb2=$('#vipnowBtn'); if(vb2){ vb2.setAttribute('href', vipUrl); }
    /* she already chose the campus, so do not sell it to her again */
    var up=$('#upgrade'); if(up){ up.style.display='none'; }
    setTimeout(function(){ if(vn) vn.scrollIntoView({behavior:'smooth',block:'center'}); },900);
  }

  /* ---- serial ---- */
  var n=Math.floor(1000+Math.random()*8999);
  $('#tSerial').textContent='No. RLU-'+n;

  /* ---- barcode ---- */
  var bars=$('#bars'), html='';
  for(var i=0;i<34;i++){ html+='<i></i>'; }
  bars.innerHTML=html;

  /* ---- campus link on the upsell card ---- */
  var vb=$('#vipBtn');
  if(vb){
    var url=window.RLU_VIP_URL||'#';
    if(url.indexOf('URL_HERE')<0){ vb.setAttribute('href',url); }
    else { vb.setAttribute('href','#'); }
  }

  /* ---- calendar. One night, no recurrence. Campus members get the extra
          half hour on their calendar, General Admission does not. ---- */
  var TITLE='The Retention Room - Rich Lash University';
  var DESC='One hour live on Zoom, 8 to 9 PM ET. Bring a photo of a set that didn\'t last, and the name of your adhesive.';
  function z(d){ return d.toISOString().replace(/[-:]/g,'').split('.')[0]+'Z'; }
  function endISO(){ return isVip ? (window.RLU_END_VIP_ISO||window.RLU_END_ISO) : window.RLU_END_ISO; }
  window.rluGCal=function(){
    var s=new Date(window.RLU_START_ISO), e=new Date(endISO());
    var u='https://calendar.google.com/calendar/render?action=TEMPLATE'
      +'&text='+encodeURIComponent(TITLE)
      +'&dates='+z(s)+'/'+z(e)
      +'&location='+encodeURIComponent('Live on Zoom')
      +'&details='+encodeURIComponent(DESC);
    window.open(u,'_blank','noopener');
  };
  window.rluICS=function(){
    var s=new Date(window.RLU_START_ISO), e=new Date(endISO());
    var ics=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Rich Lash University//EN','CALSCALE:GREGORIAN','METHOD:PUBLISH','BEGIN:VEVENT',
      'UID:'+Date.now()+'@richlash.university','DTSTAMP:'+z(new Date()),
      'DTSTART:'+z(s),'DTEND:'+z(e),
      'SUMMARY:'+TITLE,'DESCRIPTION:'+DESC,'LOCATION:Live on Zoom','STATUS:CONFIRMED',
      'BEGIN:VALARM','TRIGGER:-PT15M','ACTION:DISPLAY','DESCRIPTION:The Retention Room starts in 15 minutes','END:VALARM',
      'END:VEVENT','END:VCALENDAR'].join('\r\n');
    var b=new Blob([ics],{type:'text/calendar'});
    var a=document.createElement('a');
    a.href=URL.createObjectURL(b);
    a.download='the-retention-room.ics';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
  };

  /* ---- reveals ---- */
  var io=new IntersectionObserver(function(e){
    e.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });
  },{threshold:.12,rootMargin:'0px 0px -8% 0px'});
  Array.prototype.forEach.call(document.querySelectorAll('.reveal'),function(el){io.observe(el)});
})();
</script>
